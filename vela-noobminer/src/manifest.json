    { "name": "system.prompt" },
    { "name": "system.vibrator" },
    { "name": "system.audio" },
    { "name": "system.device" }
  ],
  "router": {
    "entry": "Index",
    "pages": {
      "Index": { "component": "index", "path": "/" },
      "Game": { "component": "game", "path": "/game" }
    }
  },
  "display": {
    "backgroundColor": "#0e0e14"
  }
}
