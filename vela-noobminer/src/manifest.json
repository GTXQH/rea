{
  "package": "com.vela.noobminer",
  "name": "挖矿逃生",
  "icon": "/common/icon.png",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minAPILevel": 1,
  "deviceTypeList": ["watch"],
  "config": {
    "logLevel": "log"
  },
  "features": [
    { "name": "system.router" },
